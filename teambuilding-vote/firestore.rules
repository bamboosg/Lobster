rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validPoll() {
      let data = request.resource.data;
      return data.keys().hasAll(['ownerUid', 'title', 'dates', 'createdAt'])
        && data.keys().hasOnly(['ownerUid', 'title', 'dates', 'createdAt'])
        && data.ownerUid == request.auth.uid
        && data.title is string && data.title.size() > 0 && data.title.size() <= 80
        && data.dates is list && data.dates.size() >= 3 && data.dates.size() <= 4
        && data.dates.toSet().size() == data.dates.size()
        && data.dates[0] is string && data.dates[0].matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.dates[1] is string && data.dates[1].matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.dates[2] is string && data.dates[2].matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (data.dates.size() == 3 || (data.dates[3] is string && data.dates[3].matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && data.createdAt == request.time;
    }

    function validVote(pollId) {
      let data = request.resource.data;
      return data.keys().hasAll(['name', 'dates'])
        && data.keys().hasOnly(['name', 'dates'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 60
        && data.dates is list && data.dates.size() >= 1 && data.dates.size() <= 2
        && data.dates.toSet().size() == data.dates.size()
        && data.dates.hasOnly(get(/databases/$(database)/documents/polls/$(pollId)).data.dates);
    }

    match /polls/{pollId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == 'REPLACE_WITH_ADMIN_UID'
        && request.auth.token.firebase.sign_in_provider == 'password'
        && validPoll();
      allow update, delete: if false;

      match /votes/{voterUid} {
        allow read: if signedIn()
          && exists(/databases/$(database)/documents/polls/$(pollId));
        allow create, update: if signedIn()
          && request.auth.uid == voterUid
          && validVote(pollId);
        allow delete: if false;
      }
    }
  }
}
